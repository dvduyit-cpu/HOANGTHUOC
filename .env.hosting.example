APP_NAME="Hoang Thuoc Medical"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hosting_database
DB_USERNAME=hosting_user
DB_PASSWORD="replace-with-database-password"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
# Port 587: smtp (STARTTLS). Port 465: smtps.
MAIL_SCHEME=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=hr@your-domain.com
MAIL_PASSWORD="replace-with-mail-password"
MAIL_FROM_ADDRESS=hr@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"
HR_EMAIL=hr@your-domain.com

ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=""
